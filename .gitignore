# Sekrety
.env
.env.local
*.key
*.pem

# Zależności i wytwory budowania
node_modules/
dist/
target/
budowa/danaco-console
budowa/danaco-console.exe

# Rdzen wkladany do pakietu powloki. Wytwor budowy, nie zrodlo — wazy
# ponad 80 MB i dwa takie pliki weszly juz raz do historii repozytorium.
budowa/desktop/src-tauri/zasoby-natywne/rdzen/
budowa/desktop/src-tauri/zasoby-natywna-linux/rdzen/
budowa/instalator/src-tauri/zasoby-natywne/rdzen/

# Stan lokalny
*.db
*.db-shm
*.db-wal
*.log

# Narzędzia systemowe
.DS_Store
__pycache__/
*.pyc

# Katalog roboczy sesji
.claude/

# Zlozone instalatory. Wytwor budowy, nie zrodlo — powstaje skryptem
