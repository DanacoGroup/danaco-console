# Danaco Console — wzorzec konfiguracji środowiska rdzenia.
# Plik produkcyjny: budowa\.env — POZA kontrolą wersji.
# Żadnych danych produkcyjnych w tym wzorcu.
#
# Zasada wzorca: deklarowana jest wyłącznie zmienna, którą rdzeń rzeczywiście
# czyta. Wykaz nazw prowadzi jedna funkcja — konfiguracja.ZmienneSrodowiska()
# w server/internal/konfiguracja/srodowisko.go. Zmienna zadeklarowana bez
# odczytu jest niewypełnionym szablonem, czyli atrapą — a atrap w produkcie nie ma.
# Nowa zmienna wchodzi do wzorca razem z kodem, który ją czyta, nie wcześniej.
#
# Kolejność warstw: wartość domyślna → zmienna środowiska → argument wywołania.
# Zmienna pusta lub nieustawiona pozostawia wartość dotychczasową
# (brak ustawienia = wartość domyślna, brak nie blokuje startu).

# --- Rdzeń ---------------------------------------------------------------

# Rola procesu: hub | agent | all. Domyślnie "all" — rdzeń lokalny.
#   hub    — tor interfejsu: nasłuch transportu na DANACO_PORT, bez toru
#            wykonawczego na strumieniach procesu
#   agent  — wyłącznie tor wykonawczy: żądania kontraktu wierszami wejścia
#            standardowego, odpowiedzi wierszami wyjścia; żaden port nie jest
#            zajmowany (agent lokalny urządzenia użytkownika)
#   all    — oba tory w jednym procesie
# Odpowiednik w wierszu poleceń: --role
DANACO_ROLA=all

# Port nasłuchu rdzenia. Domyślnie 17870 — wartość wybrana świadomie spoza
# portów zajętych na danaco-system (8090, 8091, 8093, 8095, 8760, 8766, 8771,
# 8772, 8790, 9980, 18765). Źródłem prawdy dla tej liczby jest PortDomyslny
# w server/internal/konfiguracja/ustawienia.go — ten wiersz jest jej przykładową
# kopią (wartością wzorca), nie źródłem. Tę samą liczbę zna też klient
# (client/src/polaczenie/adres-rdzenia.ts, PORT_RDZENIA_LOKALNEGO) — zmiana
# tutaj wymaga zmiany tam. Rozjazd tych kopii już raz spowodował usterkę.
# Odpowiednik w wierszu poleceń: --port
DANACO_PORT=17870

# Katalog danych rdzenia: baza SQLite i pozostała trwałość.
# Puste = %LOCALAPPDATA%\DanacoConsole
# Odpowiednik w wierszu poleceń: --dane
DANACO_KATALOG_DANYCH=

# Katalog pakietu interfejsu serwowanego obok gniazda. Puste = klient\dist
# względem katalogu roboczego procesu. Katalog nieistniejący nie wstrzymuje
# nasłuchu — gniazdo pracuje bez plików statycznych.
# Odpowiednik w wierszu poleceń: --klient
DANACO_KATALOG_KLIENTA=

# Katalog profili kanału głównego — konta rotacji. Trzyma katalogi
# profili, nie same poświadczenia: rdzeń zna wyłącznie odwołanie, a wartości
# zostają na dysku poza repozytorium i poza bazą. Puste = pula kont
# startuje pusta, a brak konta zgłasza dopiero próba rozmowy.
# Odpowiednik w wierszu poleceń: --profile
DANACO_KATALOG_PROFILI=

# --- Brzeg transportu ----------------------------------------------------

# Interfejs nasłuchu rdzenia. Puste = pętla zwrotna 127.0.0.1, czyli rdzeń
# osiągalny wyłącznie z tej maszyny. Wskazanie adresu wystawia rdzeń szerzej
# i wypisuje ostrzeżenie do dziennika: rdzeń nie ma jeszcze uwierzytelniania
# transportu, więc wykona komendy każdego, kto ten adres dosięgnie.
# Odpowiednik w wierszu poleceń: --adres
DANACO_ADRES=

# Nasłuch na WSZYSTKICH interfejsach maszyny (true|false). Osobno od adresu,
# bo "nie wskazałem" i "chcę wszędzie" to dwa różne zdania. Wartość nieczytelna
# zatrzymuje start — pomyłka w zapisie rozstrzyga tu o wystawieniu w sieci.
# Odpowiednik w wierszu poleceń: --wszystkie-interfejsy
DANACO_WSZYSTKIE_INTERFEJSY=

# Para plików warstwy TLS. Wskazanie OBU przełącza nasłuch na wss; wskazanie
# jednego zatrzymuje start, bo praca otwartym tekstem po wskazaniu certyfikatu
# byłaby cichym zejściem poniżej wskazania. Puste = otwarty tekst (domyślnie
# rdzeń stoi na pętli zwrotnej, więc ruch nie opuszcza maszyny).
# Odpowiedniki w wierszu poleceń: --tls-certyfikat, --tls-klucz
DANACO_TLS_CERTYFIKAT=
DANACO_TLS_KLUCZ=

# Wykaz wzorców nagłówka Origin przyjmowanych przy nawiązaniu gniazda, po
# przecinku (np. https://konsola.firma.pl). DOPISUJE się do pochodzeń własnych
# produktu (powłoka Tauri, pętla zwrotna IPv4 i IPv6), nie zastępuje ich —
# wystawienie pod domenę nie jest powodem, żeby produkt przestał wpuszczać
# własną powłokę. Puste = wyłącznie pochodzenia własne.
# Odpowiednik w wierszu poleceń: --pochodzenia
DANACO_POCHODZENIA=

# Czy połączenie musi przedstawić token sesji bramki, zanim wykona cokolwiek.
# TRZY STANY, NIE DWA:
#   puste  — rozstrzyga adres nasłuchu: pętla zwrotna bez wymogu, nasłuch
#            szerszy z wymogiem (Operator na własnej maszynie nie widzi zmiany);
#   true   — wymóg obowiązuje TAKŻE na pętli zwrotnej;
#   false  — wymóg zniesiony także przy nasłuchu szerszym. Wolno, ale dziennik
#            mówi o tym wprost: rdzeń wykonuje wtedy komendy każdego, kto
#            dosięgnie adresu, łącznie z torem zdalnym do maszyn Operatora.
# Odmowa wraca kodem kontraktu not_authenticated; bez tokenu przechodzą wyłącznie
# connection.hello, auth.login i auth.register.
# Odpowiednik w wierszu poleceń: --wymog-logowania
DANACO_WYMOG_LOGOWANIA=

# --- Konto nadawcze platformy --------------------------------------------
#
# Nim idą DWA listy systemowe i żadne inne: potwierdzenie adresu przy
# rejestracji oraz droga odzyskania konta. Nie jest to skrzynka Operatora —
# tamtą podpina się komendą mail.account.add i służy jego własnej poczcie.
#
# Rozdzielenie jest celowe: gdyby platforma pisała kontem Operatora, utrata
# dostępu do tej skrzynki odcinałaby drogę odzyskania konta dokładnie wtedy,
# gdy jest potrzebna.
#
# Brak tych wartości NIE wstrzymuje startu rdzenia. Wstrzymuje wyłącznie
# rejestrację — odmową nazywającą brak wprost, bo konto założone bez wysłanego
# listu byłoby kontem, do którego nikt nie ma jak wejść.
DANACO_NADAWCA_HOST=
DANACO_NADAWCA_PORT=
DANACO_NADAWCA_UZYTKOWNIK=
DANACO_NADAWCA_SEKRET=
DANACO_NADAWCA_ADRES=
DANACO_NADAWCA_NAZWA=
# Puste = szyfrowanie włączone. false wolno ustawić wyłącznie dla przekaźnika
# na tej samej maszynie: poświadczenie nadawcy idzie wtedy otwartym tekstem.
DANACO_NADAWCA_STARTTLS=

# --- Świadomie nieobecne we wzorcu ---------------------------------------
#
# Poniższych ustawień nie ma we wzorcu, bo żaden kod ich nie czyta. Wpis wróci
# tu razem z implementacją, która go odczyta:
#
#   adres rdzenia dla agenta   — po powstaniu transportu sieciowego agenta;
#                                tor wykonawczy roli `agent` pracuje na
#                                strumieniach procesu, więc adresu nie czyta
#   ścieżka programu Claude    — kanał główny modelu
#   klucze kanałów API         — z założenia nie tutaj: rejestr kanałów buduje
#                                się z tabeli kanal_modelu w czasie działania,
#                                a klucze wpisuje Operator w oknie
#                                konfiguracji
#   faza wdrożenia             — po powstaniu uwierzytelniania
#   poziom dziennika           — po powstaniu dziennika sterowanego ustawieniem
#
# Zmienne budowania interfejsu (VITE_*) nie należą do tego pliku: Vite czyta
# je z katalogu client/, nie z budowa/.
