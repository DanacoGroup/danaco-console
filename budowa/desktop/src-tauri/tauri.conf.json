{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Danaco Console",
  "version": "1.0.0",
  "identifier": "pl.danaco.console",
  "build": {
    "beforeDevCommand": {
      "script": "npm run dev",
      "cwd": "../../client",
      "wait": false
    },
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": {
      "script": "npm run build",
      "cwd": "../../client"
    },
    "frontendDist": "../../client/dist"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": {
      "zasoby/rdzen/danaco-console.exe": "rdzen/danaco-console.exe",
      "zasoby/rdzen/danaco-narzedzia.exe": "rdzen/danaco-narzedzia.exe",
      "zasoby/rdzen/dist/": "rdzen/dist/",
      "zasoby/pomocniki/": "pomocniki/",
      "zasoby/dokumentacja/": "dokumentacja/"
    },
    "publisher": "Danaco Holding Group Sp. z o.o.",
    "copyright": "© 2026 Danaco Holding Group Sp. z o.o.",
    "category": "DeveloperTool",
    "shortDescription": "Danaco Console — AI Operating Environment",
    "longDescription": "Powłoka natywna Danaco Console: okno interfejsu, rdzeń w tle, ikona w zasobniku.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
