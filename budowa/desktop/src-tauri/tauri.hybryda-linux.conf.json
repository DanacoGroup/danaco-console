{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "beforeBuildCommand": null,
    "frontendDist": "../../client/dist"
  },
  "bundle": {
    "targets": ["deb", "appimage"],
    "shortDescription": "Danaco Console — okno klienta (rdzeń na serwerze)",
    "longDescription": "Danaco Console w wariancie hybrydowym: natywne okno interfejsu na urządzeniu Operatora, rdzeń pracuje na serwerze. Instalka nie niesie rdzenia ani serwera narzędzi — host rdzenia wskazuje się w oknie albo zmienną DANACO_HOST_RDZENIA.",
    "resources": {
      "zasoby/rdzen/danaco-console.exe": null,
      "zasoby/rdzen/danaco-narzedzia.exe": null,
      "zasoby/rdzen/dist/": null,
      "zasoby/pomocniki/": null,
      "zasoby/dokumentacja/": null,
      "../../../README.md": "dokumentacja/README.md",
      "../../../INSTALACJA-I-KONFIGURACJA.md": "dokumentacja/INSTALACJA-I-KONFIGURACJA.md",
      "../../../INSTRUKCJA-UZYTKOWANIA.md": "dokumentacja/INSTRUKCJA-UZYTKOWANIA.md",
      "../../../LICENSE.md": "dokumentacja/LICENSE.md"
    },
    "category": "DeveloperTool",
    "linux": {
      "deb": {
        "section": "utils",
        "priority": "optional"
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
