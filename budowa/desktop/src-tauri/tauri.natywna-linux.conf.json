{
  "$schema": "https://schema.tauri.app/config/2",
  "mainBinaryName": "danaco-console-powloka",
  "bundle": {
    "targets": ["deb"],
    "resources": null,
    "shortDescription": "Danaco Console — natywne środowisko pracy z AI",
    "longDescription": "Instalka natywna Danaco Console: powłoka okna, rdzeń danaco-console, serwer narzędzi danaco-narzedzia, pakiet interfejsu i dokumentacja produktu. Całe serce platformy stoi na tej maszynie — praca bez serwera. Programy arsenału, które niesie dystrybucja, wchodzą zależnościami pakietu; pozostałe stawia dołączony skrypt arsenału (danaco-console-arsenal).",
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0 | libgtk-3-0t64",
          "ca-certificates",
          "curl",
          "unzip",
          "xz-utils",
          "tesseract-ocr",
          "tesseract-ocr-pol",
          "tesseract-ocr-eng",
          "ffmpeg",
          "imagemagick",
          "poppler-utils",
          "pandoc",
          "libreoffice",
          "espeak-ng",
          "openssh-client",
          "picocom",
          "shellcheck",
          "python3",
          "python3-venv",
          "python3-pip",
          "nodejs",
          "npm",
          "p7zip-full | 7zip",
          "chromium | chromium-browser | google-chrome-stable",
          "telnet | inetutils-telnet | telnet-ssl",
          "golang-go | golang",
          "mesa-vulkan-drivers"
        ],
        "recommends": [
          "shfmt",
          "sane-utils",
          "xdg-utils",
          "fonts-liberation",
          "libvulkan1"
        ],
        "section": "utils",
        "priority": "optional",
        "files": {
          "/usr/lib/danaco-console-natywna/rdzen/danaco-console": "zasoby-natywna-linux/rdzen/danaco-console",
          "/usr/lib/danaco-console-natywna/rdzen/danaco-narzedzia": "zasoby-natywna-linux/rdzen/danaco-narzedzia",
          "/usr/lib/danaco-console-natywna/rdzen/dist": "zasoby-natywna-linux/rdzen/dist",
          "/usr/lib/danaco-console-natywna/pomocniki": "zasoby-natywna-linux/pomocniki",
          "/usr/lib/danaco-console-natywna/arsenal/arsenal-serwera.sh": "zasoby-natywna-linux/arsenal/arsenal-serwera.sh",
          "/usr/share/doc/danaco-console-natywna/README.md": "zasoby-natywna-linux/dokumentacja/README.md",
          "/usr/share/doc/danaco-console-natywna/INSTALACJA-I-KONFIGURACJA.md": "zasoby-natywna-linux/dokumentacja/INSTALACJA-I-KONFIGURACJA.md",
          "/usr/share/doc/danaco-console-natywna/INSTRUKCJA-UZYTKOWANIA.md": "zasoby-natywna-linux/dokumentacja/INSTRUKCJA-UZYTKOWANIA.md",
          "/usr/share/doc/danaco-console-natywna/LICENSE.md": "zasoby-natywna-linux/dokumentacja/LICENSE.md"
        },
        "postInstallScript": "zasoby-natywna-linux/maintainer/postinst",
        "preRemoveScript": "zasoby-natywna-linux/maintainer/prerm"
      }
    }
  }
}
