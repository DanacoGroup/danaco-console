# Nastawy serwera Danaco Console — plik czytany jednostką systemd
# (EnvironmentFile). Każdy wiersz to ZMIENNA=wartość, bez „export" i bez
# rozwijania powłoki. Po zmianie: systemctl restart danaco-console
#
# Wartości wpisane w jednostce (nasłuch 127.0.0.1:17870, wymóg logowania,
# katalog danych, katalog interfejsu, plik klucza sejfu) obowiązują bez tego
# pliku. Wpis tutaj je nadpisuje.

# ── Nasłuch ──────────────────────────────────────────────────────────────────
# Rozstrzygnięcie 29: rdzeń stoi na pętli zwrotnej, a na świat wystawia go Caddy
# jako console.danaco-group.pl:443. Inny adres tylko wraz z odpowiednim wpisem
# w Caddyfile; DANACO_WSZYSTKIE_INTERFEJSY=1 wystawiłoby rdzeń bez Caddy.
# DANACO_PORT=17870
# DANACO_ADRES=127.0.0.1

# ── Warstwa TLS ──────────────────────────────────────────────────────────────
# Przy wdrożeniu z rozstrzygnięcia 29 TLS kończy się na Caddy (ACME) i te
# zmienne zostają puste. Wskazanie OBU plików przełącza gniazdo rdzenia na wss.
# Wskazanie jednego zatrzymuje start — cicha praca otwartym tekstem po wskazaniu
# certyfikatu byłaby zejściem poniżej wskazania. Pliki czytelne dla konta usługi.
# DANACO_TLS_CERTYFIKAT=/etc/danaco-console/tls/serwer.crt
# DANACO_TLS_KLUCZ=/etc/danaco-console/tls/serwer.key

# ── Wymóg logowania ──────────────────────────────────────────────────────────
# Jednostka ustawia DANACO_WYMOG_LOGOWANIA=true i ten wpis MUSI zostać: bez
# niego rdzeń na pętli zwrotnej uznaje każde połączenie za Operatora, a Caddy
# wystawia go publicznie — konsola stałaby w sieci bez bramki. Wartość logiczna
# Go (true|false); „tak" zatrzymuje start. Ustawienie false jest odrzucane
# i wypisane w dzienniku startu.
DANACO_WYMOG_LOGOWANIA=true

# ── Sekret nawiązania gniazda ────────────────────────────────────────────────
# Rdzeń porównuje wartość z parametrem `sekret` adresu gniazda albo nagłówkiem
# X-Danaco-Sekret. Przy wdrożeniu serwerowym sekret podaje klient w adresie —
# powłoka bierze go ze zmiennej DANACO_SEKRET_NAWIAZANIA na urządzeniu Operatora.
# Puste = bez sprawdzenia.
# DANACO_SEKRET_NAWIAZANIA=

# ── Sejf poświadczeń ─────────────────────────────────────────────────────────
# Plik klucza pieczętującego sejf: 32 bajty albo 64 znaki szesnastkowe, prawa
# 0400, właściciel danaco-console. Jednostka wskazuje go sama, a postinst zakłada
# brakujący. Inna ścieżka — wyłącznie poza katalogiem danych.
# DANACO_KLUCZ_SEJFU=/etc/danaco-console/sejf.klucz

# ── Pochodzenia gniazda ──────────────────────────────────────────────────────
# Dodatkowe wzorce nagłówka Origin przyjmowane przy nawiązaniu gniazda;
# pochodzeń własnych produktu nie zastępują. Nazwa console.danaco-group.pl
# wpisu nie potrzebuje: Caddy przekazuje nagłówek Host bez zmiany, a Origin
# równy Host przechodzi bez wzorca; powłoka Windows przedstawia się
# tauri.localhost, które jest pochodzeniem własnym. Wpis jest potrzebny dopiero
# dla strony podawanej spod innej nazwy niż rdzeń.
# DANACO_POCHODZENIA=https://konsola.firma.pl

# ── Konto nadawcze platformy ─────────────────────────────────────────────────
# Nim idą dwa listy systemowe: potwierdzenie adresu przy rejestracji i droga
# odzyskania konta. To NIE jest skrzynka Operatora. Brak tych wartości nie
# wstrzymuje startu — wstrzymuje wyłącznie rejestrację, odmową nazywającą brak.
# DANACO_NADAWCA_HOST=smtp.firma.pl
# DANACO_NADAWCA_PORT=587
# DANACO_NADAWCA_UZYTKOWNIK=konsola@firma.pl
# DANACO_NADAWCA_SEKRET=
# DANACO_NADAWCA_ADRES=konsola@firma.pl
# DANACO_NADAWCA_NAZWA=Danaco Console
# Zejście do rozmowy otwartym tekstem dla przekaźnika na tej samej maszynie:
# DANACO_NADAWCA_STARTTLS=nie

# ── Arsenał mowy i modeli ────────────────────────────────────────────────────
# Katalogi, w które skrypt arsenału kładzie wagi modelu i środowisko mowy.
# DANACO_KATALOG_MODELI=/opt/danaco-arsenal/modele-mowy
# DANACO_SRODOWISKO_MOWY=/opt/danaco-arsenal/mowa
